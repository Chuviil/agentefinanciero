# Azure AI Foundry — gpt-5-mini (ADR-0002)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
OPENAI_API_VERSION=
LLM_REASONING_EFFORT=low

# Precios USD por 1M de tokens (validar contra la tarifa Azure del despliegue real)
PRICE_INPUT_PER_MTOK=0.25
PRICE_CACHED_INPUT_PER_MTOK=0.025
PRICE_OUTPUT_PER_MTOK=2.00

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=financial-analysis-agent

# Límites
MAX_STEPS=8
MAX_TOKENS_BUDGET=10000
TIMEOUT_GLOBAL_S=45
# RATE_LIMIT_RPS = cuota_RPM_del_despliegue / (60 * numero_de_procesos)  (ADR-0005)
RATE_LIMIT_RPS=
CB_MAX_REPEATS=2
CB_MAX_CONSECUTIVE_ERRORS=3
# Estimación fija (tokens) del costo de la siguiente llamada usada por guard
INITIAL_CALL_ESTIMATE_TOKENS=2000
